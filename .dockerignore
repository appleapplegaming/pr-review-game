# Keep the build context small and keep local artifacts, secrets and dev tooling out of the image.
# The image is built from the lockfile and sources inside the build stage, so local output is never reused.

# Dependencies and build output (rebuilt inside the image)
node_modules
dist
coverage
playwright-report
test-results

# Version control and editor files
.git
.gitignore
.github
.vscode
.idea

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Project planning, docs and agent tooling (not needed to build or run the game)
.claude
tasks
docs
*.md
!README.md

Dockerfile
.dockerignore
